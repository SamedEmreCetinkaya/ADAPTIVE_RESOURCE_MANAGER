[Unit]
Description=Adaptive Resource Manager: focused application priority and swap readback
Documentation=file:///usr/local/share/doc/adaptive-resource-manager/README.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/adaptive-resource-managerd
Restart=on-failure
RestartSec=10
Nice=-5
OOMScoreAdjust=-500
# Relative limit so the daemon scales with the machine.
MemoryMax=1%
UMask=0077
RuntimeDirectory=adaptive-resource-manager
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
# SYS_ADMIN: swapoff and swap offsets in pagemap. SYS_NICE: process_madvise and CPU affinity.
# SYS_PTRACE: other users' address spaces. DAC_OVERRIDE: user-owned cgroup files and pagemap.
# CHOWN: gives the focus socket to the active seat user.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_NICE CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys/fs/cgroup -/var/lib/swapspace
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
KeyringMode=private
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @swap process_madvise pidfd_open
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
