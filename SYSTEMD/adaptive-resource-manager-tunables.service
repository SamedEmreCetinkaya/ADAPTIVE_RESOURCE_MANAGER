[Unit]
Description=Adaptive Resource Manager: memory settings relative to this machine
DefaultDependencies=no
After=local-fs.target systemd-sysctl.service
Before=swapspace.service adaptive-resource-manager.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/adaptive-resource-manager/APPLY_SYSTEM_TUNABLES.sh
UMask=0022
NoNewPrivileges=yes
ProtectHome=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=sysinit.target
